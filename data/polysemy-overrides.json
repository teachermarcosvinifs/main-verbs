    {"label":"ir embora / sair","pattern":"go / have to go","examples":["I have to go","What time does the last train go?"]},
    {"label":"ficar / tornar-se","pattern":"go + adjective","examples":["go quiet","go wrong","go bad"]},
    {"label":"fazer uma atividade","pattern":"go + -ing","examples":["go shopping","go swimming"]}
  ],
  "cover": [
    {"label":"cobrir fisicamente","pattern":"cover + object / surface","examples":["cover the table","cover the wound"]},
    {"label":"abranger / tratar","pattern":"cover + topic / area","examples":["cover the main points","The course covers four topics"]},
    {"label":"cobrir um custo","pattern":"cover + cost / expense","examples":["The fee covers breakfast","Insurance covers the repairs"]},
